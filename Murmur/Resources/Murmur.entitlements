<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow microphone capture. Murmur is not sandboxed because the
	     Accessibility API (used to paste into other apps) is unavailable to sandboxed apps. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
